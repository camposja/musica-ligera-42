generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  USER
}

enum PlaylistSource {
  MANUAL
  SPOTIFY_IMPORT
  CLONE
}

model User {
  id             String     @id @default(uuid())
  name           String     @unique
  role           Role
  accessCode     String
  spotifyUserId  String?
  createdAt      DateTime   @default(now())

  playlists      Playlist[]
}

model Song {
  id             String         @id @default(uuid())
  title          String
  artist         String
  album          String?

  spotifyId      String?        @unique

  youtubeId      String?
  youtubeAltIds  String[]

  // Match-quality metadata. Null on legacy matches written before
  // the looser-matching ticket (Ticket 8). New + rematched songs
  // populate these so the UI can label exact vs loose matches.
  youtubeMatchType    String?  // "exact" | "loose"
  youtubeMatchReason  String?  // "exact" | "live" | "lyric_video" | "official_audio" | "acoustic" | "remaster" | "remix" | "close" | "manual"
  youtubeMatchTitle   String?  // YouTube result title at match time
  youtubeMatchChannel String?  // YouTube channel name at match time

  createdAt      DateTime       @default(now())

  playlistSongs  PlaylistSong[]
}

model Playlist {
  id           String         @id @default(uuid())
  name         String
  userId       String
  user         User           @relation(fields: [userId], references: [id])
  songs        PlaylistSong[]
  createdAt    DateTime       @default(now())

  source       PlaylistSource @default(MANUAL)
  locked       Boolean        @default(false)
  clonedFromId String?
  importedAt   DateTime?
  sourceLabel  String?

  @@index([userId])
  @@index([clonedFromId])
}

model PlaylistSong {
  id          String    @id @default(uuid())
  playlistId  String
  songId      String
  order       Int
  createdAt   DateTime  @default(now())

  playlist    Playlist  @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  song        Song      @relation(fields: [songId], references: [id])

  @@unique([playlistId, songId])
  @@index([playlistId])
  @@index([songId])
}

model SpotifyConnection {
  id             String   @id @default("singleton")
  accessToken    String
  refreshToken   String
  expiresAt      DateTime
  scope          String
  spotifyUserId  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Daily quota ledger for shared external API budgets. One row per
// (service, day-in-UTC). Increments are application-side; we never query
// the upstream provider for remaining quota.
model ApiQuotaUsage {
  id        String   @id @default(uuid())
  service   String   // "youtube"
  day       String   // "YYYY-MM-DD" in UTC
  unitsUsed Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([service, day])
  @@index([service, day])
}

// Day-scoped cache of YouTube search results. Keyed by (day, normalizedQuery).
// Only successful, non-empty payloads are cached. Force-refresh paths bypass
// the cache so a wrong cached match isn't stuck for 24 hours.
model YoutubeSearchCache {
  id              String   @id @default(uuid())
  day             String   // "YYYY-MM-DD" in UTC
  normalizedQuery String   // trim + lowercase + collapse whitespace
  payloadJson     String   // serialized YoutubeSearchResult[]
  createdAt       DateTime @default(now())

  @@unique([day, normalizedQuery])
  @@index([createdAt])
}

// Singleton row of app-wide settings. New flags get added as columns here.
// Read via `getAppSettings()` which upserts the row on first access.
model AppSetting {
  id                     String   @id @default("singleton")
  allowChildSpotifyLogin Boolean  @default(false)
  updatedAt              DateTime @updatedAt
}
